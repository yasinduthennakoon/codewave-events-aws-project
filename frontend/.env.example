# Copy this to .env and fill in values after backend deploys.
#
# Get these by running:
#   aws ssm get-parameter --name /cloudwave/dev/cognito/userPoolId --query Parameter.Value --output text
#   aws ssm get-parameter --name /cloudwave/dev/cognito/clientId   --query Parameter.Value --output text
#
# The API base URL is the "endpoint" output printed by `serverless deploy`.
# Each microservice has its own endpoint; the frontend uses one base per service.

VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Each microservice has its own HTTP API URL. Plug them in here.
VITE_API_AUTH=https://aaaaaaaaaa.execute-api.us-east-1.amazonaws.com
VITE_API_EVENTS=https://bbbbbbbbbb.execute-api.us-east-1.amazonaws.com
VITE_API_REGISTRATIONS=https://cccccccccc.execute-api.us-east-1.amazonaws.com
VITE_API_FILES=https://dddddddddd.execute-api.us-east-1.amazonaws.com
