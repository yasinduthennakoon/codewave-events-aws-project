# Copy this to .env and fill in values after backend deploys.
#
# VITE_API_BASE is the endpoint printed by `serverless deploy` for auth-service.
# All microservices share the same API Gateway, so one URL covers everything.

VITE_AWS_REGION=ap-southeast-1
VITE_API_BASE=https://aaaaaaaaaa.execute-api.ap-southeast-1.amazonaws.com
